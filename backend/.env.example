# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in what you need.
#
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)
#
# .env is gitignored. Real environment variables always win over this file, so
# a one-off `$env:XTIMELINE_STORE=mongo` still overrides it for a single run.
# ---------------------------------------------------------------------------

# --- the app ---------------------------------------------------------------
# The password the login screen wants. Change it.
XTIMELINE_PASSWORD=changeme

# Where the API listens. Keep 127.0.0.1 unless you mean to expose it.
XTIMELINE_HOST=127.0.0.1
XTIMELINE_PORT=8000

# Signing key for bearer tokens. Leave unset to let the app generate and keep
# one in backend/.auth_secret; set it if you run more than one worker.
# XTIMELINE_SECRET=
XTIMELINE_TOKEN_TTL_MIN=720

# --- history store (MongoDB) ----------------------------------------------
# Local mongod:
XTIMELINE_MONGO_URI=mongodb://127.0.0.1:27017
# ...or MongoDB Atlas (URL-encode any @ : / ? in the password):
# XTIMELINE_MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/xtimeline?retryWrites=true&w=majority

# auto   = use MongoDB if it answers, otherwise memory (history lost on restart)
# mongo  = MongoDB or refuse to start
# memory = no database at all
XTIMELINE_STORE=auto

# Defaults to the database named in the URI, else "xtimeline".
# XTIMELINE_MONGO_DB=xtimeline

# --- scraping -------------------------------------------------------------
# Politeness knobs. Raise the delay if X rate-limits you.
XTIMELINE_SCROLL_DELAY_MS=1200
XTIMELINE_NAV_TIMEOUT_MS=60000
XTIMELINE_WAIT_TWEETS_MS=20000
XTIMELINE_ACCOUNT_PAUSE_MIN_MS=1500
XTIMELINE_ACCOUNT_PAUSE_MAX_MS=3500

# Send a normal desktop User-Agent instead of the headless one X blocks.
# XTIMELINE_USER_AGENT=
# Set to 1 to force Playwright's bundled headless shell (less detectable-proof).
# XTIMELINE_NO_CHANNEL=1

# Use your own Chrome/Edge binary instead of Playwright's Chromium.
# XTIMELINE_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 1 in containers that need --no-sandbox.
# XTIMELINE_NO_SANDBOX=1
